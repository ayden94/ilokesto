{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "PACKAGES.md",
    "ARCHITECTURE.md",
    "COMMANDS.md"
  ],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "gh pr merge*": "ask",
      "gh issue create*": "ask",
      "*": "ask"
    }
  }
}