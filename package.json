{
  "name": "@ilokesto/form",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/form"
  },
  "homepage": "https://ilokesto.ayden94.com/en/form",
  "packageManager": "pnpm@10.17.1",
  "sideEffects": false,
  "keywords": [
    "form",
    "validation"
  ],
  "author": "Jeong Jinho <wpfekdml@me.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./vue": {
      "import": "./dist/vue/index.js",
      "types": "./dist/vue/index.d.ts"
    },
    "./solid": {
      "import": "./dist/solid/index.js",
      "types": "./dist/solid/index.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte/index.js",
      "types": "./dist/svelte/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ilokesto/store": "1.1.1",
    "immer": "^11.1.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.6",
    "solid-js": "^1.9.13",
    "svelte": "^5.55.9",
    "typescript": "^6.0.2",
    "vite": "^7.3.3",
    "vitest": "^4.1.7",
    "vue": "^3.5.34",
    "@changesets/cli": "^2.28.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vue": "^3.5.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
